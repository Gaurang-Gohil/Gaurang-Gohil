# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files with sensitive data
*.tfvars
*.tfvars.json

# Override files (used for local debugging)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output
*.plan

# Module directories
**/.terraform.lock.hcl

# Provider binaries
.terraform/providers/

# Ignore IDE/editor files
.vscode/
.idea/
*.iml

# OS-specific junk
.DS_Store
Thumbs.db
